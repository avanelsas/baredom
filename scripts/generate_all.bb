#!/usr/bin/env bb
;; generate_all.bb: Write dist/all.js and dist/all.d.ts, the entry that registers every component.
;;
;; The source is `all-registers` in src/baredom/registry.cljs. Each entry becomes an import of
;; its own module in dist/. Run it after `shadow-cljs release lib`. It fails when a listed
;; module is not in dist/.
;;
;; Usage: bb scripts/generate_all.bb

(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def ^:private registry-file "src/baredom/registry.cljs")
(def ^:private dist-dir "dist")

;; ── the registry ────────────────────────────────────────────────────────────

(defn- all-registers
  "The entries of the `all-registers` vector in `source`."
  [source]
  (some (fn [form]
          (when (and (seq? form) (= ['def 'all-registers] (take 2 form)))
            (last form)))
        (edn/read-string (str "[" source "]"))))

(defn- tags
  "The tag of each entry of `registers`, in order."
  [registers]
  (mapv namespace registers))

;; ── the output ──────────────────────────────────────────────────────────────

(defn- module-file
  "The file name of the module of `tag` in dist/."
  [tag]
  (str tag ".js"))

(defn- identifier
  "The JavaScript name of the init function of `tag`: x-avatar-group gives xAvatarGroup."
  [tag]
  (str/replace tag #"-([a-z0-9])" (fn [[_ c]] (str/upper-case c))))

(defn- import-line [[tag id]]
  (str "import { init as " id " } from './" (module-file tag) "';"))

(defn- call-line [[_ id]]
  (str "  " id "();"))

(defn- all-js
  "The text of all.js for `tags`."
  [tags]
  (let [named (map (juxt identity identifier) tags)]
    (str/join "\n" (concat ["// all.js: generated by generate_all.bb, do not edit."
                            "// init() registers every component."
                            ""]
                           (map import-line named)
                           ["" "export function init() {"]
                           (map call-line named)
                           ["}" ""]))))

(def ^:private all-d-ts
  (str/join "\n" ["// all.d.ts: generated by generate_all.bb, do not edit."
                  ""
                  "/** Registers every component. Idempotent. */"
                  "export declare function init(): void;"
                  ""]))

(defn- missing
  "The tags of `tags` whose module is not among the file names `present`."
  [tags present]
  (remove (comp present module-file) tags))

;; ── the effects ─────────────────────────────────────────────────────────────

(defn- main []
  (let [tags    (tags (all-registers (slurp registry-file)))
        absent  (missing tags (set (.list (io/file dist-dir))))]
    (when (seq absent)
      (binding [*out* *err*]
        (println "generate_all: no module in dist/ for" (str/join ", " absent))
        (println "Build first with: npx shadow-cljs release lib"))
      (System/exit 1))
    (spit (io/file dist-dir "all.js") (all-js tags))
    (spit (io/file dist-dir "all.d.ts") all-d-ts)
    (println "Generated dist/all.js and dist/all.d.ts for" (count tags) "components")))

(when (= *file* (System/getProperty "babashka.file"))
  (main))
