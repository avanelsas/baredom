   ["x-kbd" "--x-kbd-shadow" "inset 0 -1px 0 rgba(0,0,0,0.08)"]
   ["x-kbd" "--x-kbd-shadow" "inset 0 -1px 0 rgba(0,0,0,0.4)"]]]
