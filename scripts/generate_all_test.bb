#!/usr/bin/env bb
;; generate_all_test.bb: Tests for generate_all.bb.
;;
;; Usage: bb scripts/generate_all_test.bb

(load-file "scripts/generate_all.bb")
(require '[clojure.test :refer [deftest is run-tests]])

(def ^:private registry
  "(ns baredom.registry
     \"Canonical list.\"
     (:require [baredom.exports.x-alert :as x-alert]
               [baredom.exports.x-avatar-group :as x-avatar-group]))

   (def all-registers
     \"Every component.\"
     [x-alert/register!
      x-avatar-group/register!])")

(deftest the-tags-come-from-all-registers-in-order
  (is (= ["x-alert" "x-avatar-group"] (tags (all-registers registry)))))

(deftest an-identifier-is-the-tag-in-camel-case
  (is (= "xAvatarGroup" (identifier "x-avatar-group")))
  (is (= "xH2Title" (identifier "x-h2-title"))))

(deftest all-js-imports-each-module-and-calls-each-init
  (is (= (str/join "\n" ["// all.js: generated by generate_all.bb, do not edit."
                         "// init() registers every component."
                         ""
                         "import { init as xAlert } from './x-alert.js';"
                         "import { init as xAvatarGroup } from './x-avatar-group.js';"
                         ""
                         "export function init() {"
                         "  xAlert();"
                         "  xAvatarGroup();"
                         "}"
                         ""])
         (all-js ["x-alert" "x-avatar-group"]))))

(deftest a-tag-without-its-module-is-missing
  (is (= ["x-avatar-group"] (missing ["x-alert" "x-avatar-group"] #{"x-alert.js" "base.js"}))))

(deftest no-tag-is-missing-when-every-module-is-present
  (is (empty? (missing ["x-alert"] #{"x-alert.js"}))))

(let [{:keys [fail error]} (run-tests)]
  (System/exit (if (zero? (+ fail error)) 0 1)))
